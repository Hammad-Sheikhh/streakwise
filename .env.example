# Copy this file to `.env` and fill in the values. Never commit `.env`.
# One Supabase project serves every environment (SPEC D15).
# Wrap a value in double quotes if it contains `#`, spaces, or quotes: an unquoted `#` starts a
# comment, so everything after it would be silently dropped.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...). Server-side only — never expose it to the browser.
SUPABASE_SECRET_KEY=
# Random value (at least 32 characters) used to sign the login session cookie.
SESSION_SECRET=
# Optional: the old single-user passcode. Only used once, to move the data from before accounts
# into the owner's account (SPEC ACCT-7). Can be removed after that.
APP_PASSCODE=
